# Copy to ~/.config/ear-sidecar/env and chmod 600.
# Never commit real values. Never paste secrets into chat.
XAI_API_KEY=

# Optional: Grok Bot webhook routine (backup wake; live cadence is the agent jsonl loop)
# EAR_WEBHOOK_URL=          # from routine panel: Webhook URL
# EAR_WEBHOOK_AUTH=         # from routine panel: Authorization header / Webhook key (raw key OK; ear.py adds Bearer)
# EAR_JSONL=                # default ~/sand-knowledge/live-call.jsonl or install-dir live-call.jsonl
